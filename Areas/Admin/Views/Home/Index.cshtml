@model _25DH190113_LTW.Models.ViewModel.ProductSearchVM
@{
    ViewBag.Title = "Quản lý Nhạc cụ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm p-3 mb-4 bg-white rounded">
    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
    {
        <div class="row g-2 align-items-center justify-content-center">
            <div class="col-md-4">
                @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Nhập tên, mô tả hoặc loại nhạc cụ..." })
            </div>
            <div class="col-md-3">
                @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", placeholder = "Giá tối thiểu (VNĐ)", type = "number" })
            </div>
            <div class="col-md-3">
                @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", placeholder = "Giá tối đa (VNĐ)", type = "number" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary fw-bold">🔍 Tìm kiếm</button>
            </div>
        </div>

        <div class="text-center mt-3">
            <strong>Sắp xếp theo: </strong>
            @Html.ActionLink("Tên tăng dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, new { @class = "mx-1" }) |
            @Html.ActionLink("Tên giảm dần", "Index", new { sortOrder = "name_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, new { @class = "mx-1" }) |
            @Html.ActionLink("Giá tăng dần", "Index", new { sortOrder = "price_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, new { @class = "mx-1" }) |
            @Html.ActionLink("Giá giảm dần", "Index", new { sortOrder = "price_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }, new { @class = "mx-1" })
        </div>
    }
</div>

@Html.Partial("PVListProduct", Model)