@model _25DH190113_LTW.Models.Product

<div class="mb-3 row">
    <label class="col-md-2 col-form-label fw-bold">Danh mục nhạc cụ</label>
    <div class="col-md-10">
        @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
    </div>
</div>

<div class="mb-3 row">
    <label class="col-md-2 col-form-label fw-bold">Tên nhạc cụ</label>
    <div class="col-md-10">
        @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="mb-3 row">
    <label class="col-md-2 col-form-label fw-bold">Mô tả chi tiết</label>
    <div class="col-md-10">
        @Html.TextAreaFor(model => model.ProductDecription, new { @class = "form-control", rows = "4" })
        @Html.ValidationMessageFor(model => model.ProductDecription, "", new { @class = "text-danger" })
    </div>
</div>

<div class="mb-3 row">
    <label class="col-md-2 col-form-label fw-bold">Đơn giá (VNĐ)</label>
    <div class="col-md-10">
        @Html.EditorFor(model => model.ProductPrice, new { htmlAttributes = new { @class = "form-control", type = "number" } })
        @Html.ValidationMessageFor(model => model.ProductPrice, "", new { @class = "text-danger" })
    </div>
</div>

<div class="mb-3 row">
    <label class="col-md-2 col-form-label fw-bold">Hình ảnh nhạc cụ</label>
    <div class="col-md-10">
        <input type="file" name="UploadImg" class="form-control mb-2" accept="image/*" />
        @Html.EditorFor(model => model.ProductImage, new { htmlAttributes = new { @class = "form-control", placeholder = "Hoặc nhập đường dẫn ảnh (ví dụ: /Content/Images/yamaha-f310.jpg)" } })
    </div>
</div>

<div class="mb-3 row">
    <label class="col-md-2 col-form-label fw-bold">Tệp âm thanh nghe thử</label>
    <div class="col-md-10">
        @Html.EditorFor(model => model.AudioDemoUrl, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: /Content/Audio/guitar-demo.mp3" } })
    </div>
</div>