@model _25DH190113_LTW.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc

@if (Model.Products != null && Model.Products.Any())
{
    <h4 class="bg-success text-white p-2 mt-3 rounded">DANH SÁCH NHẠC CỤ TIỆM BÁ DƯƠNG</h4>
    <table class="table table-bordered table-hover bg-light align-middle">
        <thead class="table-success">
            <tr>
                <th style="width:140px;">Hình ảnh</th>
                <th>Tên nhạc cụ</th>
                <th>Đơn giá</th>
                <th>Danh mục</th>
                <th style="width:220px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td class="text-center">
                        <img src="@product.ProductImage" alt="@product.ProductName" style="height:90px; max-width:120px; object-fit:cover; border-radius:6px;" />
                    </td>
                    <td class="fw-bold">@product.ProductName</td>
                    <td class="text-danger fw-bold">@product.ProductPrice.ToString("N0") VNĐ</td>
                    <td>@(product.Category != null ? product.Category.CategoryName : "")</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm me-1" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-info btn-sm text-white me-1" })
                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center my-3">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new
        {
            page,
            searchTerm = Model.SearchTerm,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = Model.SortOrder
        }))
    </div>
}
else
{
    <div class="alert alert-warning mt-3">Không tìm thấy nhạc cụ nào phù hợp với từ khóa.</div>
}

<div class="mt-3">
    @Html.ActionLink("+ Thêm nhạc cụ mới", "Create", null, new { @class = "btn btn-success fw-bold" })
</div>