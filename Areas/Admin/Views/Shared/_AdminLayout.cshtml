<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản Trị Hệ Thống Tiệm Bá Dương</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                🛠️ ADMIN - TIỆM BÁ DƯƠNG
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Index", "Categories", new { area = "Admin" })">Danh mục (Category)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Index", "Products", new { area = "Admin" })">Sản phẩm (Product)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Index", "Users", new { area = "Admin" })">Tài khoản Admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="@Url.Action("Index", "Customers", new { area = "Admin" })">Khách hàng & Đơn hàng</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (Session["AdminUsername"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-warning">Admin: @Session["AdminUsername"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-bold" href="@Url.Action("Logout", "Account", new { area = "Admin" })">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" href="@Url.Action("Login", "Account", new { area = "Admin" })">Đăng nhập</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content my-4">
        @RenderBody()
    </div>

    <footer class="bg-light text-center py-3 mt-5 border-top">
        <small>Hệ thống Quản trị Website Nhạc cụ Tiệm Bá Dương - 25DH190113_LTW</small>
    </footer>
</body>
</html>
