@model _25DH190113_LTW.Models.ViewModel.Cart
@{
    ViewBag.Title = "Giỏ hàng của bạn";
}

<h2 class="fw-bold my-3">🛒 GIỎ HÀNG TIỆM BÁ DƯƠNG</h2>

@if (Model == null || !Model.Items.Any())
{
    <div class="alert alert-info p-4 text-center">
        <h5>Bạn chưa có nhạc cụ nào trong giỏ hàng.</h5>
        <a href="@Url.Action("Index", "Home")" class="btn btn-warning fw-bold mt-2">Quay lại chọn nhạc cụ</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-md-9">
            @foreach (var categoryGroup in Model.GroupedItems)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-dark text-warning fw-bold">
                        🎵 Danh mục: @categoryGroup.Key
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th colspan="2">Sản phẩm nhạc cụ</th>
                                    <th style="width: 160px;">Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                    <th>
                                        <a href="@Url.Action("ClearCart", "Cart")" class="text-danger" title="Xóa toàn bộ giỏ">🗑️ Xóa hết</a>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in categoryGroup)
                                {
                                    <tr>
                                        <td style="width: 90px;">
                                            <img src="@item.ProductImage" alt="@item.ProductName" style="max-height: 70px;" />
                                        </td>
                                        <td class="fw-bold">@item.ProductName</td>
                                        <td>
                                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                <input type="hidden" name="id" value="@item.ProductID" />
                                                <div class="input-group input-group-sm" style="width: 120px;">
                                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-outline-secondary">-</button>
                                                    <input type="text" class="form-control text-center" value="@item.Quantity" readonly />
                                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-outline-secondary">+</button>
                                                </div>
                                            }
                                        </td>
                                        <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                                        <td class="text-danger fw-bold">@item.TotalPrice.ToString("N0") VNĐ</td>
                                        <td>
                                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-outline-danger">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h5 class="fw-bold">Tổng thanh toán</h5>
                <hr />
                <p class="fs-4 text-danger fw-bold">@Model.TotalValue().ToString("N0") VNĐ</p>
                <div class="d-grid gap-2">
                    @Html.ActionLink("Tiến hành Mua hàng", "Checkout", "Order", null, new { @class = "btn btn-danger btn-lg fw-bold" })
                    @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-warning fw-bold" })
                </div>
            </div>
        </div>
    </div>
}