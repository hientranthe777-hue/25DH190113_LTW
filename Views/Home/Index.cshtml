@model _25DH190113_LTW.Models.ViewModel.HomeProductVM
@using PagedList.Mvc
@{
    ViewBag.Title = "Trang chủ - Tiệm Nhạc Cụ Bá Dương";
}

<!-- Khung giới thiệu nổi bật của Tiệm Bá Dương -->
<section class="banner p-5 mb-4 text-center text-white rounded-3 shadow" style="background: linear-gradient(135deg, #1e130c 0%, #9a8478 100%);">
    <div class="container py-3">
        <h1 class="display-5 fw-bold text-warning">🎵 TIỆM NHẠC CỤ BÁ DƯƠNG</h1>
        <p class="fs-5 mb-3">Đánh thức đam mê âm nhạc với đàn Guitar, Piano, Trống chính hãng – Nghe thử âm thanh trực tiếp!</p>
        <a href="#new-products" class="btn btn-warning btn-lg fw-bold px-4">Khám phá nhạc cụ ngay</a>
    </div>
</section>

<!-- Thanh lọc nhanh theo Danh mục nhạc cụ -->
@if (ViewBag.Categories != null)
{
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark fw-bold">Tất cả nhạc cụ</a>
        @foreach (var cat in ViewBag.Categories as IEnumerable<_25DH190113_LTW.Models.Category>)
        {
            <a href="@Url.Action("Index", "Home", new { categoryId = cat.CategoryID })" class="btn btn-outline-secondary">
                @cat.CategoryName
            </a>
        }
    </div>
}

<!-- Phần Tìm kiếm sản phẩm -->
<section class="searchProd text-center my-4">
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="d-flex justify-content-center">
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
                @id = "search-input",
                @class = "form-control w-50 me-2",
                placeholder = "Nhập tên đàn guitar, piano, trống hoặc danh mục..."
            })
            <button type="submit" id="search-button" class="btn btn-dark px-4">🔍 Tìm kiếm</button>
        </div>
    }
</section>
<hr />

<!-- PHẦN 1: NHẠC CỤ NỔI BẬT -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section id="featureProd" class="my-4">
        <h2 class="text-center fw-bold text-uppercase mb-4" style="color: #8b4513;">🔥 Nhạc Cụ Nổi Bật</h2>
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var item in Model.FeaturedProducts.Take(4))
            {
                <div class="col">
                    <div class="card h-100 shadow-sm product-item text-center p-2">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">
                            <img src="@item.ProductImage" alt="@item.ProductName" class="card-img-top" style="height: 200px; object-fit: contain;" />
                        </a>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-secondary mb-1">@(item.Category != null ? item.Category.CategoryName : "")</span>
                                <h5 class="card-title fw-bold">@item.ProductName</h5>
                                <p class="price text-danger fw-bold fs-5 mb-1">@item.ProductPrice.ToString("N0") VNĐ</p>
                                <small class="text-muted d-block mb-2">Đã bán: @(item.OrderDetails != null ? item.OrderDetails.Count : 0)</small>
                            </div>

                            <div>
                                @if (!string.IsNullOrEmpty(item.AudioDemoUrl))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted d-block mb-1">🔊 Nghe thử âm thanh:</small>
                                        <audio controls preload="none" src="@item.AudioDemoUrl" style="width: 100%; height: 34px;"></audio>
                                    </div>
                                }
                                <div class="d-flex justify-content-center gap-2 mt-1">
                                    <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" class="btn btn-sm btn-info text-white">Xem chi tiết</a>
                                    <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-warning fw-bold">+ Giỏ hàng</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
<hr />

<!-- PHẦN 2: DANH SÁCH NHẠC CỤ MỚI (CÓ PHÂN TRANG) -->
<section id="new-products" class="my-4">
    <h2 class="text-center fw-bold text-uppercase mb-4" style="color: #8b4513;">🎸 Danh Sách Nhạc Cụ</h2>
    @if (Model.NewProducts != null && Model.NewProducts.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model.NewProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm product-item text-center p-3">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">
                            <img src="@item.ProductImage" alt="@item.ProductName" class="card-img-top" style="height: 220px; object-fit: contain;" />
                        </a>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-dark mb-1">@(item.Category != null ? item.Category.CategoryName : "")</span>
                                <h5 class="card-title fw-bold">@item.ProductName</h5>
                                <p class="text-muted small">@item.ProductDecription</p>
                                <p class="price text-danger fw-bold fs-5">@item.ProductPrice.ToString("N0") VNĐ</p>
                            </div>
                            <div>
                                @if (!string.IsNullOrEmpty(item.AudioDemoUrl))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted d-block mb-1">🔊 Nghe thử âm thanh:</small>
                                        <audio controls preload="none" src="@item.AudioDemoUrl" style="width: 100%; height: 34px;"></audio>
                                    </div>
                                }
                                <div class="d-flex justify-content-center gap-2 mt-1">
                                    <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" class="btn btn-sm btn-info text-white">Xem chi tiết</a>
                                    <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-warning fw-bold">Thêm vào giỏ</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Thanh phân trang -->
        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">Không tìm được nhạc cụ nào phù hợp với từ khóa của bạn.</div>
    }
</section>