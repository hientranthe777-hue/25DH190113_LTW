@model _25DH190113_LTW.Models.Order
@{
    ViewBag.Title = "Xác nhận đơn hàng";
}

<div class="card shadow-sm p-4 my-4">
    <h2 class="text-success fw-bold">✅ ĐẶT HÀNG THÀNH CÔNG!</h2>
    <p class="text-muted">Cảm ơn bạn đã mua sắm nhạc cụ tại Tiệm Bá Dương. Dưới đây là chi tiết đơn hàng của bạn:</p>
    <hr />
    <div class="row mb-3">
        <div class="col-md-6">
            <p><strong>Mã đơn hàng:</strong> #@Model.OrderID</p>
            <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
            <p><strong>Tổng số tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</span></p>
        </div>
        <div class="col-md-6">
            <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
            <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
            <p><strong>Phương thức giao hàng:</strong> @(Model.ShippingMethod ?? Model.DeliveryMethod)</p>
            <p><strong>Địa chỉ giao hàng:</strong> @(Model.ShippingAddress ?? Model.AddressDelivery)</p>
        </div>
    </div>

    <h5 class="fw-bold">Chi tiết nhạc cụ trong đơn:</h5>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Tên nhạc cụ</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Tổng giá</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@(item.Product != null ? item.Product.ProductName : "")</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                    <td class="fw-bold text-danger">@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a href="@Url.Action("Index", "Home")" class="btn btn-warning fw-bold">Tiếp tục mua sắm</a>
        <a href="@Url.Action("OrderHistory", "Order")" class="btn btn-outline-dark ms-2">Xem lịch sử đơn hàng</a>
    </div>
</div>