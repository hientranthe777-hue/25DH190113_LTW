<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Tiệm Nhạc Cụ Bá Dương</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" href="@Url.Action("Index", "Home", new { area = "" })">
                🎵 TIỆM BÁ DƯƠNG
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Cart", new { area = "" })">
                            Giỏ hàng (@(Session["CartCount"] ?? 0))
                        </a>
                    </li>
                    @if (Session["Username"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("OrderHistory", "Order", new { area = "" })">Lịch sử mua hàng</a>
                        </li>
                    }
                </ul>

                <!-- Form Tìm kiếm nhạc cụ trên Header -->
                @using (Html.BeginForm("Index", "Home", new { area = "" }, FormMethod.Get, new { @class = "d-flex me-3" }))
                {
                    <input class="form-control me-2" type="search" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Tìm đàn guitar, piano, trống..." />
                    <button class="btn btn-outline-warning" type="submit">Tìm</button>
                }

                <!-- Khu vực Đăng ký / Đăng nhập / Đăng xuất -->
                <ul class="navbar-nav">
                    @if (Session["Username"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-info">Xin chào, @Session["CustomerName"]!</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="@Url.Action("Logout", "Account", new { area = "" })">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "Account", new { area = "" })">Đăng ký</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content my-4">
        @RenderBody()
    </div>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container text-center">
            <h5>TIỆM NHẠC CỤ BÁ DƯƠNG</h5>
            <p class="mb-1">Địa chỉ: 43/21 Bình Tây, Phường Bình Tiên, TP.HCM | Điện thoại: 0325406579</p>
            <small>&copy; @DateTime.Now.Year - Dự án Lập Trình Trên Web (25DH190113_LTW)</small>
        </div>
    </footer>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
