<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tiệm Bá Đường</title>
    <link rel="stylesheet" href="~/Content/Site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <header>
        <div class="logo">
            <h1>Tiệm Bá Đường</h1>
        </div>
        <nav>
            <a href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a>
            <a href="@Url.Action("Index", "Cart", new { area = "" })">Giỏ hàng (@(Session["CartCount"] ?? 0))</a>

            @if (Session["Username"] != null)
            {
                <a href="@Url.Action("OrderHistory", "Order", new { area = "" })">Lịch sử mua hàng</a>
                <span>Xin chào, @Session["CustomerName"]</span>
                <a href="@Url.Action("Logout", "Account", new { area = "" })">Đăng xuất</a>
            }
            else
            {
                <a href="@Url.Action("Register", "Account", new { area = "" })">Đăng ký</a>
                <a href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập</a>
            }
            <ul>
                <li><a href="/">Trang chủ</a></li>
                <li><a href="#">Sản phẩm</a></li>
                <li><a href="#">Liên hệ</a></li>
            </ul>
        </nav>
        <div class="cart">
            <a href="#">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count">3</span>
            </a>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer style="background-color: #333; color: white; padding: 20px; text-align: center; margin-top: 40px;">
        <h3>Cửa Hàng Nhạc Cụ Tiệm Bá Đường</h3>
        <p>Địa chỉ: 43/21 Bình Tây, phường Bình Tiên, TPHCM</p>
        <p>Số điện thoại liên hệ: 0325406579</p>
    </footer>
</body>
</html>